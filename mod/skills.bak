{
  "meta": {
    "description": "BRICK RUSH 99 化學技能對照表。全面升級為 14 種標準化 Action，根據分子量換算為具體的 Level，並補回所有化合物專屬的背景說明 Flavor Text。",
    "derivedFieldsNote": "atomCount 由 elements 內所有數量加總得出；avgAtomicWeight = molecularWeight / atomCount；strength 由下方公式在遊戲載入時即時計算，不寫死在本檔案中。",
    "strengthFormula": "strength = clamp(molecularWeight * STRENGTH_BASE_COEFFICIENT - avgAtomicWeight * AVG_ATOMIC_WEIGHT_PENALTY_COEFFICIENT, MIN_STRENGTH, MAX_STRENGTH)",
    "costFormula": "cost = molecularWeight * MOLECULAR_WEIGHT_TO_COST_RATIO"
  },
  "constants": {
    "MOLECULAR_WEIGHT_TO_COST_RATIO": 1,
    "STRENGTH_BASE_COEFFICIENT": 1.0,
    "AVG_ATOMIC_WEIGHT_PENALTY_COEFFICIENT": 0.5,
    "MIN_STRENGTH": 10,
    "MAX_STRENGTH": 999
  },
